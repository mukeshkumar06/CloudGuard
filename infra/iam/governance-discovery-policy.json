{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudGuardTagDiscoveryReadOnly",
      "Effect": "Allow",
      "Action": [
        "lambda:ListFunctions",
        "lambda:ListTags",
        "dynamodb:ListTables",
        "dynamodb:DescribeTable",
        "dynamodb:ListTagsOfResource",
        "s3:ListAllMyBuckets",
        "s3:GetBucketTagging",
        "s3:GetBucketLocation",
        "ec2:DescribeInstances"
      ],
      "Resource": "*"
    }
  ]
}
